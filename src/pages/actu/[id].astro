---
import Layout from '@layouts/Layout.astro';
import {type CollectionEntry, getCollection, render} from 'astro:content';
import {withBase} from "@utils/paths.ts";
import ButtonBack from "@components/info/ButtonBack.astro";

interface Props {
    article: CollectionEntry<'actu'>;
}

export async function getStaticPaths() {
    const articles = await getCollection('actu');
    return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
    }));
    }

const { article } = Astro.props;
const { Content } = await render(article);

const formattedDate = article.data.date.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'short',
    day: 'numeric'
    });
---

<Layout>
    <article class="blog-post">
        <ButtonBack target="/actu"></ButtonBack>
        <a href={withBase("/actu")}>
        <h1>{article.data.title}</h1>
        </a>
        <div class="card bordered h">
            <div>
                <time class="card__content" datetime={article.data.date.toISOString()}>{formattedDate}</time>
            </div>
            <div class="card__content">
                <span>{article.data.author}</span>
            </div>
        </div>
        {article.data.tags.length > 0 && (
                <div class="cards">
                    {article.data.tags.map((tag) => (
                            <span class="tag">{tag}</span>
                    ))}
                </div>
        )}
        <div class="card v">
            <Content />
        </div>
    </article>
</Layout>

<style>
    .tag {
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
        border-radius: var(--border-radius);
        padding: 0.2rem;
    }
</style>