---
import Layout from '@layouts/Layout.astro';
import {type CollectionEntry, getCollection, render} from 'astro:content';

interface Props {
    article: CollectionEntry<'actu'>;
}

export async function getStaticPaths() {
    const articles = await getCollection('actu');
    return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
    }));
    }

const { article } = Astro.props;
const { Content } = await render(article);

const formattedDate = article.data.date.toLocaleDateString('fr-FR', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
    });
---

<Layout>
    <article class="blog-post">
        <h1>{article.data.title}</h1>
        <div class="card h bordered">
                <time class="card__titre" datetime={article.data.date.toISOString()}>{formattedDate}</time>
            <div class="card__content">
                <span>{article.data.author}</span>
            </div>
        </div>
        {article.data.tags.length > 0 && (
                <div class="cards">
                    {article.data.tags.map((tag) => (
                            <span class="tag">{tag}</span>
                    ))}
                </div>
        )}
        <Content />
    </article>
</Layout>

<style>
    .tag {
        color: var(--color-primary);
        border: 1px solid var(--color-primary);
        border-radius: 1rem;
        padding: 0.2rem;
    }
</style>