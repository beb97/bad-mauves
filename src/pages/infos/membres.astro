---
import MembreCard from "@components/info/Membre.astro";
import {membres, bureau} from "@data/membres.ts";
import ButtonBack from "@components/info/ButtonBack.astro";
import Layout from "@layouts/Layout.astro";
import InfoCard from "@components/info/InfoCard.astro";

export interface Membre {
    initiales: string;
    nom: string;
    role?: string;
}
---
<Layout>
    <article class="members-card">
        <ButtonBack target="/infos"/>
        <!--🦸‍-->
        <section class="cards">
            <InfoCard
                    logo="diversity_4" ,
                    nom="bureau" ,
                    lien="/infos"
            ></InfoCard>
        </section>
        <section class="members-section">
            <h2>Le bureau</h2>
                <div class="cards">
                    {bureau.map((personne: Membre) => (
                            <MembreCard
                                    initiales={personne.initiales}
                                    nom={personne.nom}
                                    role={personne.role}
                            />
                    ))}
                </div>
        </section>

        <section>
            <h2>Les membres</h2>
            <div class="cards">
                {membres.map((personne: Membre) => (
                        <MembreCard
                                initiales={personne.initiales}
                                nom={personne.nom}
                                role={personne.role}
                        />
                ))}
            </div>
        </section>
    </article>
</Layout>
<style>
    ul {
        list-style-type: none;
    }
</style>