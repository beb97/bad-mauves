---
import Layout from "@layouts/Layout.astro";
import InfoBack from "@components/info/InfoBack.astro";
import Material from "@utils/material.astro";
import ButtonBack from "@components/info/ButtonBack.astro";
import {withBase} from "@utils/paths.ts";
import InfoCard from "@components/info/InfoCard.astro";
---

<Layout>
    <article class="">
        <InfoBack />

        <div class="cards">
            <!--<ButtonBack/>-->
            <InfoCard
                    logo="stadium" ,
                    nom="salle" ,
                    lien="/infos"
            ></InfoCard>
        </div>

        <h2>Complexe Sportif</h2>
        <h3>Le Pré aux Oies</h3>
        <div class="card bordered">
            <img src={withBase("/stade_1.png")} alt="La salle"/>
        </div>
        <!--<img src={withBase("/logo/logo_club_1.svg")} alt="Les fous du volant"/>-->
        <p><a href="https://maps.app.goo.gl/QnPk2mVtkTA7wejPA" target="_blank" rel="noopener noreferrer">8 Av. de la Gare, 44470 Mauves-sur-Loire</a></p>
        <section id="gmap">
            <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2706.072811188299!2d-1.3925225232102656!3d47.293376709554224!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4805fde424ba0591%3A0xf1ddcc8ba3003bd5!2sComplexe%20Sportif%20Le%20Pr%C3%A9%20aux%20Oies!5e0!3m2!1sfr!2sfr!4v1788719316857!5m2!1sfr!2sfr"
                    width="300" height="450"
                    style="border:0"
                    allowfullscreen="" loading="lazy"
                    referrerpolicy="strict-origin-when-cross-origin">
            </iframe>
        </section>
    </article>
</Layout>

<style>
    #gmap {
        border-radius: 10px;
        overflow: hidden;
        border: 3px solid var(--color-primary);
    }
    iframe {
        border-radius: 10px;
        overflow: hidden;
    }
</style>