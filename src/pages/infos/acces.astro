---
import Layout from "@layouts/Layout.astro";
import InfoBack from "@components/info/InfoBack.astro";

import logoAsso from "@assets/img/contacts/logo_asso.png";
import {withBase} from "@utils/paths.ts";
import InfoCard from "@components/info/InfoCard.astro";
import Image from "astro/components/Image.astro";

const {logo, nom, lien} = Astro.props;
---

<Layout>
    <article>
        <InfoBack/>

        <div class="cards">
            <!--<ButtonBack/>-->
            <InfoCard
                    logo="badminton" ,
                    nom="inscription" ,
                    lien="/infos"
            ></InfoCard>
        </div>


        <section class="card">
            <div class="card__content">
                <table>
                    <tr>
                        <th>public</th>
                        <th>coût annuel</th>
                    </tr>
                    <tr>
                        <td>jeu adulte</td>
                        <td>65€</td>
                    </tr>
                    <tr>
                        <td>cours enfant</td>
                        <td>85€</td>
                    </tr>
                </table>
            </div>
        </section>


        <a class="card h button bordered" href="https://www.helloasso.com/associations/les-fous-du-volant-mauves-sur-loire"> <div>

            <div class="card__content h">

            <Image src={logoAsso} alt="helloasso"/>
            <span> inscription sur hello asso </span>
            </div>
        </div>
        </a>

        <p>(sous réserve de disponibilité)</p>
    </article>
</Layout>

<style>
    a img {
        width: 35px;
        height: 35px;
        object-fit: contain;
        margin-right: 0.5rem;
    }

    table {
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 10px;
    }

    th {
        background-color: var(--color-border);
        color: var(--color-background);
    }

    td, th {
        margin: 1rem;
        padding: 1rem;
        border: 1px solid var(--color-border);
    }

    table tr:first-child th:first-child {
        border-top-left-radius: 10px;
    }

    table tr:first-child th:last-child {
        border-top-right-radius: 10px;
    }

    table tr:last-child td:first-child {
        border-bottom-left-radius: 10px;
    }

    table tr:last-child td:last-child {
        border-bottom-right-radius: 10px;
    }
</style>
