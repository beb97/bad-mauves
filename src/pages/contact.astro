---
import Layout from "@layouts/Layout.astro";
import {links} from "@data/contacts.ts";
import ContactCard from "@components/contact/ContactCard.astro";
import {withBase} from "@utils/paths.ts";
---

<Layout>
	<article>
		<h2>Ressources externes</h2>
		<section class="cards">
			{links.map((link) => (
				<ContactCard
					href={link.href}
					logo={link.logo}
					description={link.description}
				/>
			))}
		</section>
	</article>
</Layout>
<style>
</style>
