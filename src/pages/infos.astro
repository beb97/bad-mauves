---
import type {InfoLink} from "@components/info/InfoCard.astro";
import InfoCard from "@components/info/InfoCard.astro";
import Layout from "@layouts/Layout.astro";
import {infos} from "@data/infos.ts";

---
<Layout>
<article>
	<h2>infos du club</h2>
		<section class="cards h">

		{infos.map((info: InfoLink) => (
			<InfoCard
				logo={info.logo}
				nom={info.nom}
				lien={info.lien}
			/>
		))}
		</section>
</article>
</Layout>

<style>
</style>
