---
import Horaires from "@components/info/Horaires.astro";
import {withBase} from "@utils/paths.ts";
import Layout from "@layouts/Layout.astro";
import Image from "astro/components/Image.astro";
import logo from '@assets/img/logo/logo_club_1.svg';
---

<Layout>
    <article class="cards v" id="club">
        <Image src={logo} alt="Les fous du volant" width={600} height={400}></Image>
        <section>
            <h2 class="card">club de badminton</h2>
            <h3>mauves-sur-loire</h3>
        </section>
        <section class="cards h">
            <div class="card button bordered">
                <a href={withBase("/infos/acces")}>inscription</a>
            </div>
            <div class="card button bordered">
                <a href={withBase("/infos/horaires")}>horaires</a>
            </div>
        </section>

    </article>

</Layout>
<style>

    article img {
        max-width: 600px;
    }

    #club {
        min-height: 70vh;
        justify-content: space-around;
    }

    article {
        gap: 2rem;
    }
</style>
