---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import background from "@assets/img/bg2.jpg";
import Font from "astro/components/Font.astro";
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width"/>
        <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/>
        <Font cssVariable="--font-raleway" />
        <meta name="generator" content={Astro.generator}/>
        <title>Les fous du volant</title>
    </head>
    <body>
        <!--<slot />-->
        <img id="background" src={background.src} alt="" fetchpriority="high"/>
        <Header/>
        <main id="container">
            <slot/>
            <div id="spacer"></div>
        </main>
        <Footer/>
    </body>
</html>

<style is:global>
    :root {
        --color-primary: #7c3aed;
        --color-primary-dark: #5b21b6;
        --color-secondary: #f59e0b;
        --color-background: #26024e;
        --color-surface: #ffffff;
        --color-text: #dbd3e4;
        --color-text-muted: #b3a0d3;
        --color-border: #e5e7eb;
        --color-active: #4b1e91;
    }

    html,
    body {
        margin: 0;
        width: 100%;
        min-height: 100%;
        font-size: 22px;
        cursor: url("cursor.svg") 0 0, auto;
        font-family: var(--font-raleway);
        color: var(--color-text);
        background-color: color-mix(in srgb, var(--color-background) 80%, transparent);
    }
    a:hover,
    button:hover {
        cursor: url("cursor_hover.svg") 0 0, pointer;
    }

    * {
        color: var(--color-text);
        margin: 0;
        padding: 0;
    }

    body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        max-width: 1000px;
        margin: 0 auto;
    }

    article {
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 1em;
    }

    #spacer {
        flex: 1;
    }

    a {
        text-decoration: none;
    }

    h1 {
        margin: 0;
    }

    h2, h3 {
    }

    #background {
        position: fixed;
        top: -30px;
        left: -30px;
        width: calc(100vw + 60px);
        height: calc(100vh + 60px);
        z-index: -1;
        filter: blur(20px);
        background-color: var(--color-background);
        object-fit: cover;
    }

    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .cards {
        display: flex;
        flex-wrap: wrap;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .card {
        padding: 0.5rem;
        border-radius: 1.25rem;
        background: linear-gradient(135deg, var(--color-active), transparent);
        color: var(--color-text);

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;

        text-align: center;
        transition:
                transform 0.2s ease,
                background 0.2s ease;
    }

    .card:hover {
        transform: translateY(-4px);
        background: var(--color-active);
    }

    .card__titre {
        min-width: 40px;
        height: 40px;
        border-radius: 20px;
        background: var(--color-text);
        color: var(--color-background);

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: 0.05em;
    }

    @media screen and (max-width: 768px) {
        main {
            display: flex;
            flex-direction: column;
        }
    }
</style>
