---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import background from "@assets/img/bg2.jpg";
import Font from "astro/components/Font.astro";
import ClientRouter from "astro/components/ClientRouter.astro";
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`}/>
    <Font cssVariable="--font-raleway"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
          rel="stylesheet">
    <!--<link href="https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">-->
    <!--<link href="https://fonts.googleapis.com/css2?family=Bangers&display=swap" rel="stylesheet">-->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <meta name="generator" content={Astro.generator}/>
    <ClientRouter/>
    <title>Les fous du volant</title>
</head>
<body>
<img id="background" src={background.src} fetchpriority="high"/>
<Header/>
<main id="container">
    <slot/>
    <div id="spacer"></div>
</main>
<Footer/>
</body>
</html>

<style is:global>
    :root {
        --color-primary: #7c3aed;
        --color-primary-dark: #5b21b6;
        --color-secondary: #f59e0b;
        --color-background: #26024e;
        --color-surface: #ffffff;
        --color-text: #dbd3e4;
        --color-text-muted: #b3a0d3;
        --color-border: #e5e7eb;
        --color-active: #4b1e91;
    }

    * {
        box-sizing: border-box;
        color: var(--color-text);
        margin: 0;
        padding: 0;
    }

    html,
    body {
        margin: 0;
        width: 100vw;
        min-height: 100vh;
        font-size: 20px;
        cursor: url("/cursor.svg") 0 0, auto;
        font-family: "Inter";
        font-weight: 300;
        color: var(--color-text);
        background-color: color-mix(in srgb, var(--color-background) 80%, transparent);
    }

    body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    main {
        flex: 1;
        display: flex;
        flex-direction: column;
        max-width: 600px;

        margin: 0 auto;
    }

    article {
        display: flex;
        flex-direction: column;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 1em;
        margin-bottom: 1em;
    }

    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    a {
        text-decoration: none;
    }

    a:hover,
    button:hover {
        cursor: url("/cursor_hover.svg") 0 0, pointer;
    }

    h1 {
        margin: 0;
    }

    h2, h3 {
        font-weight: normal;
    }

    article > img {
        width: 95vw;
        max-width: 600px;
    }

    p {
        font-size: 0.8rem;
    }

    #background {
        position: fixed;
        width: 100vw;
        height: calc(100vh + 60px);
        z-index: -1;
        filter: blur(10px);
        background-color: var(--color-background);
        object-fit: cover;
    }

    .link {
        text-decoration: underline;
    }

    .cards {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .card {
        border-radius: 1.25rem;
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .h {
        display: flex;
        flex-direction: row;
    }

    .v {
        display: flex;
        flex-direction: column;
    }

    .bordered {
        border: 1px solid var(--color-border);
        overflow: hidden;
    }

    .hidden {
        visibility: hidden;
    }

    .button {
        background: linear-gradient(135deg, var(--color-active), transparent);
        box-shadow: 1px 1px 2px 1px black;
        padding: 0.25rem;
    }

    .card:hover {
        transform: translateY(-4px);
        background: var(--color-active);
    }

    .card__titre {
        width: 100%;
        background: var(--color-text);
        color: var(--color-background);
        display: flex;
        justify-content: center;
        flex: 1;
        flex-grow: 1;
        flex-direction: column;
        padding: 1rem;
    }
    .card__content {
        padding: 0.5em;
    }

    @media screen and (max-width: 768px) {
        main {
            display: flex;
            flex-direction: column;
        }
    }
</style>
