---
import { ClientRouter } from "astro:transitions";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import background from "@assets/img/bg2.webp";
import Font from "astro/components/Font.astro";
import Image from "astro/components/Image.astro";
import '@style/css/variables.css';
import '@style/css/main.css';
import {withBase} from "../utils/paths";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Les fous du volant",
    description = "Club de badminton à Mauves-sur-Loire",
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <link rel="icon" type="image/svg+xml" href={withBase("/cursor.svg")}/>
    <Font cssVariable="--font-raleway"/>
    <Font cssVariable="--font-lexend"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
          rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet">
    <meta name="generator" content={Astro.generator}/>
    <meta name="description" content={description}/>
    <title>{title}</title>
</head>
<body>
<Image id="background" src={background} alt="" fetchpriority="high"/>
<Header/>
<main id="container">
    <slot/>
    <div id="spacer"></div>
</main>
<Footer/>
</body>
</html>
<style is:global>

</style>
