---
import ContactCard from "./ContactCard.astro";
import {links} from "../../data/contacts.ts";
---

<section>
	<h1>
		Contact
	</h1>
</section>
<section class="cards">
	{links.map((link) => (
		<ContactCard
			href={link.href}
			label={link.label}
			logo={link.logo}
			description={link.description}
		/>
	))}
</section>

<style>
</style>