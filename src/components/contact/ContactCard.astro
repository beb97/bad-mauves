---
export interface Contacts {
	href: string;
	logo: string;
	label: string;
	description?: string;
}

const { href, logo, label, description } = Astro.props;

const images = import.meta.glob("../../assets/img/*", {
	eager: true,
	import: "default",
});

const image = images[`../../assets/img/${logo}`] as ImageMetadata | undefined;

---

<a class="card contact-card" href={href}>

	<span class="contact-card__label">{label}</span>
	{image && (
		<img class="contact-card__logo" src={image.src} alt={label} />
	)}
	{description && (
		<span class="contact-card__description">{description}</span>
	)}
</a>

<style>
	.contact-card {
		min-width: 150px;
		min-height: 150px;
		text-decoration: none;
		border: 1px solid var(--color-border);
	}


	.contact-card__logo {
		width: 48px;
		height: 48px;
		object-fit: contain;
	}

	.contact-card__label {
		font-weight: bold;
	}

	.contact-card__description {
		font-size: 0.9rem;
		opacity: 0.85;
	}
</style>