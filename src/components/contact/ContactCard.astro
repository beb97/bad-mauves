---
export interface Contacts {
	href: string;
	logo: string;
	description?: string;
}

const { href, logo, description } = Astro.props;

const images = import.meta.glob("../../assets/img/*", {
	eager: true,
	import: "default",
});

const image = images[`../../assets/img/${logo}`] as ImageMetadata | undefined;

---

<a class="card button" href={href}>

	<!--<h2 class="">{label}</h2>-->
	{image && (
		<img class="card__logo" src={image.src} alt={description} />
	)}
	{description && (
		<div class="">{description}</div>
	)}
</a>

<style>
	.card {
		width: 40vw;
		max-width: 180px;
		text-decoration: none;
		border: 1px solid var(--color-border);
	}

	.card__logo {
		margin: 0.5rem;
		width: 48px;
		height: 48px;
		object-fit: contain;
	}
</style>