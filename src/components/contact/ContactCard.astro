---
import {withBase} from "@utils/paths.ts";
import Image from "astro/components/Image.astro";
export interface Contacts {
    href: string;
    logo: string;
    description?: string;
}
const {href, logo, description} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/img/**/*", {
    eager: true,
});

const imageModule = images[`/src/assets/img${logo}`];

if (!imageModule) {
    throw new Error(`"${logo}" does not exist in assets.`);
}

const image = imageModule.default;
---

<a href={href} target="_blank">
    <div class="card button bordered h">
        <div class="card__titre">
            {href && (
                    <Image src={image} class="card__logo" alt="Les fous du volant"></Image>
                    // <Image src={image} alt="Les fous du volant" width={60} height={60}></Image>
            )}
        </div>
        <div class="card__content"><h2 class="">{description}</h2></div>
    </div>
</a>

<style>
    .card {
        width: 70vw;
        //max-width: 220px;
        text-decoration: none;
        border: 1px solid var(--color-border);
    }

    .card__logo {
        width: 35px;
        height: 35px;
        object-fit: contain;
    }

    .card__content {
        width: 40vw;
        max-width: 200px;
    }
</style>