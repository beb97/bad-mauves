---
import {withBase} from "@utils/paths.ts";
export interface Contacts {
    href: string;
    logo: string;
    description?: string;
}

const {href, logo, description} = Astro.props;

---

<a href={href}>
    <div class="card bordered h">
        <div class="card__titre">
            {href && (
                    <img class="card__logo" src={withBase(logo)} alt={description}/>
            )}
        </div>
        <div class="card__content"><h3 class="">{description}</h3></div>
    </div>
</a>

<style>
    .card {
        width: 70vw;
        max-width: 200px;
        text-decoration: none;
        border: 1px solid var(--color-border);
    }

    .card__logo {
        width: 35px;
        height: 35px;
        object-fit: contain;
    }

    .card__content {
        width: 40vw;
        max-width: 150px;
    }
</style>