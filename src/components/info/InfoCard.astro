---
import {withBase} from "../../utils/paths.ts";
import Material from "@utils/material.astro";

export interface InfoLink {
    logo: string;
    nom: string;
    lien: string;
}

const {logo, nom, lien} = Astro.props;
---
<a href={withBase(lien)}>
    <div class="card button">
        <Material logo={logo}/>
        <!--<span class="material-symbols-outlined">{logo}</span>-->
        <h3>
            {nom}
        </h3>
    </div>
</a>

<style>
    .card {
        width: 40vw;
        max-width: 200px;
        min-height: 75px;
        min-width: 100px;
        border: 1px solid var(--color-border);
        font-weight: normal;
    }
</style>