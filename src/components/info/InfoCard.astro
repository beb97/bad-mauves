---
import {withBase} from "@utils/paths.ts";
import Material from "@utils/material.astro";

export interface InfoLink {
    logo: string;
    nom: string;
    lien: string|undefined;
}

const {logo, nom, lien} = Astro.props;
---


<a href={withBase(lien)}>
    <div class="card button bordered h">
        <div class="card__titre"><Material logo={logo}/></div>
        <div class="card__content"> <h2>{nom}</h2></div>
    </div>
</a>

<style>
    .card__content {
        width: 70vw;
        max-width: 200px;
    }
</style>