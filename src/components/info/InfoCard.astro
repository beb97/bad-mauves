---
import {withBase} from "../../utils/paths.ts";

export interface InfoLink {
    logo: string;
    nom: string;
    lien: string;
}

const {logo, nom, lien} = Astro.props;
---
<a href={withBase(lien)}>
    <div class="card button">
        <span class="material-symbols-outlined">{logo}</span>
        <h3>
            {nom}
        </h3>
    </div>
</a>

<style>
    .card {
        width: 40vw;
        max-width: 200px;
        min-height: 75px;
        min-width: 100px;
        border: 1px solid var(--color-border);
        font-weight: normal;
    }


    .material-symbols-outlined {
        font-size: 3em;
    }

</style>