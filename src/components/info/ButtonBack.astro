---
import {withBase} from "@utils/paths.ts";

const {target} = Astro.props;
---

<a class="bordered" id="back" data-back-button href={withBase(target)}> ↩ </a>
<script>
    import {goBack} from "@utils/paths.ts";
    const backButton = document.querySelector("[data-back-button]");
    backButton?.addEventListener("click", (event) => {
        goBack(event);
    });
</script>

<style>
    #back {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        padding: 1em;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        text-align: center;
        background-color: color-mix(in srgb, var(--color-background) 70%, transparent);
    }

</style>