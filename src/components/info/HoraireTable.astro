---
const horaires_cours = [
{
    public: "Enfant",
    jour: "mardi",
    debut: "18h30",
    fin: "19h30",
    encadrement: "Cours",
    },
{
    public: "Ado/Adulte",
    jour: "mardi",
    debut: "19h30",
    fin: "20h30",
    encadrement: "Cours",
    },
{
    public: "Adulte",
    jour: "mardi",
    debut: "20h30",
    fin: "21h30",
    encadrement: "Cours",
    }
];

const horaires_libre = [
{
    public: "Adulte",
    jour: "mardi",
    debut: "20h30",
    fin: "22h30",
    encadrement: "Libre",
    },
{
    public: "Adultes",
    jour: "jeudi",
    debut: "20h30",
    fin: "22h30",
    encadrement: "Libre",
    },
{
    public: "Adultes",
    jour: "samedi",
    debut: "10h45",
    fin: "12h45",
    encadrement: "Libre",
    },
