---
<table>
  <tbody>
  {horaires_libre.map((horaire) => (
      <tr>
        <td>{horaire.jour}</td>
        <td>{horaire.debut}</td>
        <td>{horaire.fin}</td>
      </tr>
  ))}
  </tbody>
</table>

<h2 id="summary-title">Cours encadrés</h2>
<table>
  <thead>
  <tr>
    <th></th>
    <th>Mardi</th>
  </tr>
  </thead>
  <tbody>
  {horaires_cours.map((horaire) => (
      <tr>
        <!--<td>{horaire.jour}</td>-->
        <td>{horaire.public}</td>
        <td>{horaire.debut} {horaire.fin}</td>
      </tr>
  ))}
  </tbody>
</table>