---
import type {InfoLink} from "@components/info/InfoCard.astro";
import InfoCard from "@components/info/InfoCard.astro";
import {withBase} from "../../utils/paths.ts";

const infos: InfoLink[] = [
    {
        logo: '🏸',
        nom: "L'accès",
        lien: '/acces',
    },
    {
        logo: '🏟️',
        nom: "La salle",
        lien: '/salle',
    },
    {
        logo: '🌟',
        nom: "L'histoire",
        lien: '/histoire',
    },
    {
        logo: '🦸‍',
        nom: "Le bureau",
        lien: '/membres',
    },
    {
        logo: '📜',
        nom: "Les règles",
        lien: '/rules',
    },
]

---

<article class="">
    <!--<h2 id="members-title">Les fous du volant</h2>-->

    <section class="card" id="club">
        <img src={withBase("/logo_club_1.png")} alt="Les fous du volant"/>
    </section>

    <section class="cards">

        {infos.map((info: InfoLink) => (
                <InfoCard
                        logo={info.logo}
                        nom={info.nom}
                        lien={info.lien}
                />
        ))}
    </section>
</article>

<style>
    article {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 1em;
    }

    .cards {
        flex-direction: row;
    }

    td {
        padding: 0 5px;
    }

    section {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
</style>
