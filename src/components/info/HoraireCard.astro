---
interface Props {
  public?: string;
  jour: string;
  debut: string;
  fin: string;
  encadrement?: string;
}

const {
  public: publicConcerne,
  jour,
  debut,
  fin,
  encadrement,
} = Astro.props;
---

<article class="horaire-card">
  <div class="card__titre horaire-card__day">
    {jour}
  </div>

  <div class="horaire-card__content">
    <p class="horaire-card__public">
      {publicConcerne}
    </p>

    <div class="horaire-card__time">
      <div>
        {debut}
      </div>
      <div>
        {fin}
      </div>
    </div>

    <!--<p class="horaire-card__type">-->
    <!--  {encadrement}-->
    <!--</p>-->
  </div>
</article>

<style>
  .horaire-card {
    width: 220px;
    min-height: 80px;
    margin: 0.25rem 0 0;
    border: 1px solid color-mix(in srgb, var(--color-border) 50%, transparent);
    border-radius: 20px;
  }

  .card__titre {
    padding: 0 1em;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;

  }

  .horaire-card__time {
    display: flex;
    flex-direction: row;
  }
</style>