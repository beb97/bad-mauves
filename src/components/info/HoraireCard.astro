---
interface Props {
    public?: string;
    jour: string;
    debut: string;
    fin: string;
    encadrement?: string;
}

const {
    public: publicConcerne,
    jour,
    debut,
    fin,
    encadrement,
} = Astro.props;
---

<section class="card bordered">
    <h2 class="card__titre">
        {jour}
    </h2>

    <div class="card__content">
        {publicConcerne &&
                <div>
                    {publicConcerne}
                </div>}
        <div>
            {debut}
        </div>
        <div>
            {fin}
        </div>
    </div>

</section>

<style scoped>
    .card {
        gap: 0;
    }
</style>