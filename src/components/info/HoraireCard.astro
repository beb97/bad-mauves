---
interface Props {
  public?: string;
  jour: string;
  debut: string;
  fin: string;
  encadrement?: string;
}

const {
  public: publicConcerne,
  jour,
  debut,
  fin,
  encadrement,
} = Astro.props;
---

<article class="horaire-card">
  <div class="card__titre horaire-card__day">
    {jour}
  </div>

  <div class="horaire-card__content">
    <h4 class="horaire-card__public">
      {publicConcerne}
    </h4>

    <p class="horaire-card__time">
      {debut} - {fin}
    </p>

    <!--<p class="horaire-card__type">-->
    <!--  {encadrement}-->
    <!--</p>-->
  </div>
</article>

<style>
  .horaire-card {
    width: 220px;
    min-height: 100px;
    margin: 0.25rem 0 0;
  }

  .card__titre {
    padding: 0 1em;
  }
</style>