---
import HoraireCard from "@components/info/HoraireCard.astro";
const horaires_cours = [
{
    public: "Enfant",
    jour: "mardi",
    debut: "18h30",
    fin: "19h30",
    encadrement: "Cours",
    },
{
    public: "Ado/Adulte",
    jour: "mardi",
    debut: "19h30",
    fin: "20h30",
    encadrement: "Cours",
    },
{
    public: "Adulte",
    jour: "mardi",
    debut: "20h30",
    fin: "21h30",
    encadrement: "Cours",
    }
];

const horaires_libre = [
{
    public: "Adulte",
    jour: "mardi",
    debut: "20h30",
    fin: "22h30",
    encadrement: "Libre",
    },
{
    public: "Adultes",
    jour: "jeudi",
    debut: "20h30",
    fin: "22h30",
    encadrement: "Libre",
    },
{
    public: "Adultes",
    jour: "samedi",
    debut: "10h45",
    fin: "12h45",
    encadrement: "Libre",
    },
];

---
<section class="horaires-section">
  <h2>Jeu libre</h2>

  <div class="horaires-list">
    {horaires_libre.map((horaire) => (
        <HoraireCard
            public={horaire.public}
            jour={horaire.jour}
            debut={horaire.debut}
            fin={horaire.fin}
            encadrement={horaire.encadrement}
        />
    ))}
  </div>
</section>

<section class="horaires-section">
  <h2>Cours encadrés</h2>

  <div class="horaires-list">
    {horaires_cours.map((horaire) => (
        <HoraireCard
            public={horaire.public}
            jour={horaire.jour}
            debut={horaire.debut}
            fin={horaire.fin}
            encadrement={horaire.encadrement}
        />
    ))}
  </div>
</section>