---
import HoraireCard from "@components/info/HoraireCard.astro";
import { horaires_cours } from "@data/horaires";
import { horaires_libre } from "@data/horaires";
---
<section class="card horaires-section">
  <h2>Jeu libre adulte</h2>

  <div class="cards">
    {horaires_libre.map((horaire) => (
        <HoraireCard
            jour={horaire.jour}
            debut={horaire.debut}
            fin={horaire.fin}
        />
      // public={horaire.public}
        // encadrement={horaire.encadrement}
    ))}
  </div>
</section>

<section class="card horaires-section">
  <h2>Cours encadrés</h2>

  <div class="cards">
    {horaires_cours.map((horaire) => (
        <HoraireCard
            public={horaire.public}
            jour={horaire.jour}
            debut={horaire.debut}
            fin={horaire.fin}
            encadrement={horaire.encadrement}
        />
    ))}
  </div>
</section>

<style>
  .horaires-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1em;
  }
</style>