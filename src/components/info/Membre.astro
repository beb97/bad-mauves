---
interface Props {
    initiales: string;
    nom: string;
    role?: string;
}

const { initiales, nom, role } = Astro.props;
---

<article class="card bordered">
    <h2 class="card__titre">
        {initiales}
    </h2>

    <div class="">
        <h3 class="">
            {nom}
        </h3>

        {role && (
                <p class="">
                    {role}
                </p>
        )}
    </div>
</article>

<style>
</style>