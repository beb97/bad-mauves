---
interface Props {
    initiales: string;
    nom: string;
    role?: string;
}

const { initiales, nom, role } = Astro.props;
---

<article class="member-card">
    <div class="member-card__initials">
        {initiales}
    </div>

    <div class="member-card__content">
        <h4 class="member-card__name">
            {nom}
        </h4>

        {role && (
                <p class="member-card__role">
                    {role}
                </p>
        )}
    </div>
</article>

<style>
    .member-card {
        width: 220px;
        min-height: 160px;
        padding: 1rem;
        border-radius: 1.25rem;
        background: linear-gradient(135deg, var(--color-active), transparent);
        color: var(--color-text);

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;

        text-align: center;
        transition:
                transform 0.2s ease,
                background 0.2s ease;
    }

    .member-card:hover {
        transform: translateY(-4px);
        background: var(--color-active);
    }

    .member-card__initials {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: var(--color-text);
        color: var(--color-background);

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 1.8rem;
        font-weight: 800;
        letter-spacing: 0.05em;
    }

    .member-card__name {
        margin: 0;
        font-size: 1.1rem;
    }

    .member-card__role {
        margin: 0.25rem 0 0;
        font-size: 0.95rem;
        opacity: 0.85;
    }
</style>