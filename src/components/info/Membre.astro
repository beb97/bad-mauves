---
interface Props {
    initiales: string;
    nom: string;
    role?: string;
}

const { initiales, nom, role } = Astro.props;
---

<article class="card member-card">
    <div class="card__titre">
        {initiales}
    </div>

    <div class="member-card__content">
        <h4 class="member-card__name">
            {nom}
        </h4>

        {role && (
                <p class="member-card__role">
                    {role}
                </p>
        )}
    </div>
</article>

<style>
    .member-card {
        width: 220px;
        min-height: 160px;
    }

    .member-card:hover {
        transform: translateY(-4px);
        background: var(--color-active);
    }

    .member-card__initials {

    }

    .member-card__name {
        margin: 0;
        font-size: 1.1rem;
    }

    .member-card__role {
        margin: 0.25rem 0 0;
        font-size: 0.95rem;
        opacity: 0.85;
    }
</style>