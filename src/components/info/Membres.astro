---
import MembreCard from "@components/info/Membre.astro";
import {membres, bureau} from "@data/membres.ts";
import type {Membre} from "@data/membres.ts";
---
<article class="members-card">
    <section class="members-section">
    <h3>Le bureau</h3>
    <div class="cards">
        {bureau.map((personne: Membre) => (
                <MembreCard
                        initiales={personne.initiales}
                        nom={personne.nom}
                        role={personne.role}
                />
        ))}
    </div>

        <h3>Les membres</h3>
        <div class="cards">
            {membres.map((personne: Membre) => (
                    <MembreCard
                            initiales={personne.initiales}
                            nom={personne.nom}
                            role={personne.role}
                    />
            ))}
        </div>
    </section>
</article>

<style>
    ul {
        list-style-type: none;
    }
</style>