---
import Horaires from "@components/info/Horaires.astro";
import {withBase} from "../../utils/paths.ts";
---

<article>
    <section class="card" id="club">
        <img src="fous_white.png" alt="Les fous du volant"/>
    </section>
</article>

<article>
    <div class="card">
        <a href={withBase("acces")}> Conditions d'accès</a>
    </div>
</article>

<Horaires/>

<style>
    #club {
        padding: 3rem 1em;
        max-width: clamp(300px, 500px, 100vw);
    }
    #club img {
        width: 100%;
    }
    h1 {
        font-size: 2em;
    }
    h2 {
        font-weight: normal;
    }
</style>
