---
import Image from "astro/components/Image.astro";
import {withBase} from "../utils/paths.ts";
import logo from '@assets/img/logo/logo_club_1.svg';
const currentPath = Astro.url.pathname;


const links = [
    // {href: withBase(""), label: "l'asso"},
    {href: withBase("actu"), label: "actu"},
    {href: withBase("infos"), label: "infos"},
    {href: withBase("contact"), label: "liens"},
];

const isHomePage = currentPath === withBase("/");

const isActive = (href: string) => {
    if (href === withBase("/")) {
        return currentPath === withBase("/");
    }
    return currentPath.startsWith(href);
};
---

<header>
    <div>
    <a href={withBase("/")}
       class:list={{
           logo: true,
           "hidden": isHomePage,
       }}>
        <Image src={logo} alt="Les fous du volant" width={90} height={70}
               transition:name="logo" />
    </a>
    <nav>
        <ul>
            {links.map((link) => (
                <li class:list={{active: isActive(link.href)}}>
                    <a href={link.href}
                       class:list={{active: isActive(link.href)}}
                       aria-current={isActive(link.href) ? "page" : undefined}
                    >
                        {link.label}
                    </a>
                </li>
            ))}
        </ul>
    </nav>
    </div>
</header>

<style>

    header {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        padding-bottom: em;
    }

    header div {
        max-width: 600px;
        display: flex;
        flex-grow: 1;
        flex-direction: row;
        justify-content: space-between;
    }

    nav {
        display: flex;
    }

    ul {
        display: flex;
        align-items: center;
        justify-content: space-around;
        list-style: none;
    }


    li {
        padding: 0.5em;
        border: 2px solid transparent;
        border-radius: var(--border-radius);
    }

    li.active {
        background: linear-gradient(135deg, var(--color-active), transparent);
    }

    li:hover {
        border: 2px solid var(--color-active);
        background: var(--color-active);
    }

    header img {
        padding: 0.1em;

        width: 100px;
    }

    a.active {
        font-weight: bold;
        color: var(--color-text);
    }
</style>
