---
import {withBase} from "../utils/paths.ts";
const currentPath = Astro.url.pathname;


const links = [
	{ href: withBase(""), label: "Le club" },
	{ href: withBase("infos"), label: "infos" },
	{ href: withBase("contact"), label: "contacts" },
];

const isActive = (href: string) => {
	if (href === withBase("/")) {
		return currentPath === withBase("/");
	}
	return currentPath.startsWith(href);
};
---

<header>
	<nav>
		<ul>
			{links.map((link) => (
				<li
					class:list={{ active: isActive(link.href) }}
				>
					<a href={link.href}
					   class:list={{ active: isActive(link.href) }}
					   aria-current={isActive(link.href) ? "page" : undefined}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<style>

	header {
		width: 100%;
		display: flex;
		justify-content: center;
		padding-bottom: 1em;
	}

	ul {
		display: flex;
		justify-content: space-around;
		list-style: none;
	}


	li {
		padding: 0.5em;
		border: 2px solid transparent;
		border-radius: 2em;
	}

	li.active {
		background: linear-gradient(135deg, var(--color-active), transparent);
	}

	li:hover {
		border: 2px solid red;
		border-color: var(--color-active);
		background: var(--color-active);
	}

	a.active {
		font-weight: bold;
		color: var(--color-text);
	}
</style>
